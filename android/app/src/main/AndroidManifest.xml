<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- F1b: pemantau latar keputusan (opsional, dinyalakan owner di Pengaturan) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Kamera hanya untuk memindai QR pemasangan (PemindaiQrActivity, offline). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Pengerasan (kontrak §6, SEC-54): tanpa cadangan/transfer data, HTTPS saja, tanpa deep link. -->
    <application
        android:label="PADEV Studio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/aturan_ekstraksi_data"
        android:networkSecurityConfig="@xml/keamanan_jaringan"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Hanya peluncur; tidak ada intent-filter VIEW/deep link yang membawa parameter perintah. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Pemindai QR pemasangan (SEC-77/SEC-76): CameraX + ZXing di proses ini, tanpa jaringan. Tidak exported;
             kamera berhenti & layar ditutup saat aplikasi ke latar. -->
        <activity
            android:name=".kunci.PemindaiQrActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@style/TemaPemindai"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode" />

        <!-- FCM data-only. Pesan dikirim ke layanan ini oleh receiver Firebase (dilindungi izin c2dm SEND),
             jadi layanan sendiri tidak perlu exported. -->
        <service
            android:name=".LayananFcm"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- F1b: mengintip relay (tanpa mengambil) agar izin/pertanyaan Claude bisa diberitahukan saat aplikasi tertutup. -->
        <service
            android:name=".PantauKeputusan"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Memantau permintaan izin Claude Code dari Mac milik pengguna lewat relay terenkripsi agar bisa dijawab saat aplikasi tertutup" />
        </service>
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="delivery_metrics_exported_to_big_query_enabled" android:value="false" />
        <!-- SEC-77: tanpa backend telemetri datatransport (dibawa firebase-messaging; FCM sendiri tidak memakainya). -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_notif" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="kabar" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
